# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same names under Project Settings → Environment Variables.

# Supabase (Project Settings → API). The publishable key is safe in the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Model providers. Server-side only: never prefix these with NEXT_PUBLIC_.
# Every step runs through OpenRouter for now, so OPENROUTER_API_KEY is the only one needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: shown to OpenRouter as the calling site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Usage tracking and the admin panel. Server-side only: never prefix these with NEXT_PUBLIC_.
# The secret key (Supabase → Project Settings → API keys → Secret keys) lets the server record
# usage events and lets the admin panel read activity across users. Without it, nothing is tracked.
SUPABASE_SECRET_KEY=
# Comma-separated emails allowed to open /admin. Everyone else gets a 404.
ADMIN_EMAILS=
