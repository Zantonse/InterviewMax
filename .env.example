# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same names under Project Settings → Environment Variables.

# Supabase (Project Settings → API). The publishable key is safe in the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Who signs people in: "supabase" (magic link and email code; the default) or "auth0".
# Data stays in Supabase either way. See README → Auth0.
AUTH_PROVIDER=supabase

# Auth0 (only read when AUTH_PROVIDER=auth0). Server-side only. Domain without https://.
# AUTH0_SECRET encrypts the session cookie: generate one with `openssl rand -hex 32`.
# Leave APP_BASE_URL unset on Vercel previews (the request's host is used); set it in production.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Model providers. Server-side only: never prefix these with NEXT_PUBLIC_.
# Every step runs through OpenRouter for now, so OPENROUTER_API_KEY is the only one needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: shown to OpenRouter as the calling site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Usage tracking and the admin panel. Server-side only: never prefix these with NEXT_PUBLIC_.
# The secret key (Supabase → Project Settings → API keys → Secret keys) lets the server record
# usage events and lets the admin panel read activity across users. Without it, nothing is tracked.
SUPABASE_SECRET_KEY=
# Comma-separated emails allowed to open /admin. Everyone else gets a 404.
ADMIN_EMAILS=

# Where the privacy and AI usage policies tell people to write.
PRIVACY_CONTACT_EMAIL=

# Deleting an account also deletes the person's Auth0 sign-ins (only matters once Auth0 is on).
# A machine-to-machine Auth0 app authorized for the Management API with only delete:users.
# Uses AUTH0_DOMAIN from the sign-in settings. Server-side only.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
